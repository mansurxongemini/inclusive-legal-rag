# OpenRouter API Key and endpoints
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models
EMBEDDING_MODEL=baai/bge-m3
GENERATION_MODEL_PRIMARY=google/gemini-2.5-flash
GENERATION_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct
# Dedicated OpenRouter Cross-Encoder Rerankers:
# - cohere/rerank-v3.5 (Recommended)
# - qwen/qwen3-reranker-8b
# - voyage/rerank-2.5
RERANK_MODEL=cohere/rerank-v3.5
# "jev" (Cohere used as fallback) or "cohere"
RERANK_PROVIDER=jev
JEV_MODEL=typesafe/jev-1.13
# candidates sent to Jev
JEV_RERANK_UNITS=30
# characters of each unit shown to Jev
JEV_RERANK_CHARS=1500
JEV_TIMEOUT_S=20.0
GATE_JEV_SCOPE_ENABLED=true
# refuse when P(in_scope) is below this ...
GATE_JEV_MIN_IN_SCOPE=0.3
# ... and P(answerable) is below this
GATE_JEV_ANSWERABLE_CEILING=0.8
# refuse any question whose P(answerable) is below this (0 = off)
GATE_JEV_MIN_ANSWERABLE=0.0
# Comma-separated OpenRouter provider slugs tried first; "" = OpenRouter default routing
LLM_PROVIDER_ORDER=deepinfra
# Allowed quantizations (excludes fp4/int4); "" = no filter
LLM_PROVIDER_QUANTIZATIONS=fp8,fp16,bf16,fp32,unknown
# Reasoning effort ("", "none", "low", "high" or "max"); "" = model default, "none" = reasoning off
GENERATION_REASONING_EFFORT=none

# Storage
STORAGE_DIR=./data/store
CACHE_DB_PATH=./data/cache/query_cache.db

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MOCK_EXTERNAL_APIS=false

# Remote administration (dashboard write actions, API-key management, feedback export).
# Send as X-Admin-Key. Direct localhost access needs no key; leave empty to disable remote admin entirely.
ADMIN_API_KEY=

# Editorial: a published curated answer whose linked Lex.uz norm changed is taken offline until reviewed.
EDITORIAL_SUSPEND_ON_CHANGE=true

# huquqplus.uz WordPress plugin (integrations/wordpress). Same value as HUQUQPLUS_RAG_WEBHOOK_SECRET in
# wp-config.php; generate with `openssl rand -hex 32`. Empty disables POST /api/v1/webhooks/huquqplus.
HUQUQPLUS_WEBHOOK_SECRET=

# Huquq+ portal maqolalarini avtomatik sinxronlash davriyligi (daqiqalarda) va holati (true/false)
HUQUQPLUS_SYNC_INTERVAL_MIN=60
HUQUQPLUS_SYNC_ENABLED=true
