# OpenRouter API Key and endpoints
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: embeddings on their own endpoint/key (e.g. LLM on another provider, embeddings on OpenRouter)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Jev reranker/gate (OpenRouter only). Empty = reuse EMBEDDING_* then OPENROUTER_*
JEV_BASE_URL=
JEV_API_KEY=

# Models
EMBEDDING_MODEL=baai/bge-m3
GENERATION_MODEL_PRIMARY=google/gemini-2.5-flash
GENERATION_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct
# Dedicated OpenRouter Cross-Encoder Rerankers:
# - cohere/rerank-v3.5 (Recommended)
# - qwen/qwen3-reranker-8b
# - voyage/rerank-2.5
RERANK_MODEL=cohere/rerank-v3.5
# "jev" (Cohere used as fallback) or "cohere"
RERANK_PROVIDER=jev
JEV_MODEL=typesafe/jev-1.13
# candidates sent to Jev
JEV_RERANK_UNITS=30
# characters of each unit shown to Jev
JEV_RERANK_CHARS=1500
JEV_TIMEOUT_S=20.0
GATE_JEV_SCOPE_ENABLED=true
# refuse when P(in_scope) is below this ...
GATE_JEV_MIN_IN_SCOPE=0.2
# ... and P(answerable) is below this (1.01 = a high P(answerable) never excuses a low scope)
GATE_JEV_ANSWERABLE_CEILING=1.01
# refuse any question whose P(answerable) is below this (0 = off)
GATE_JEV_MIN_ANSWERABLE=0.0
# Comma-separated OpenRouter provider slugs tried first; "" = OpenRouter default routing
LLM_PROVIDER_ORDER=deepinfra
# Allowed quantizations (excludes fp4/int4); "" = no filter
LLM_PROVIDER_QUANTIZATIONS=fp8,fp16,bf16,fp32,unknown
# Reasoning effort ("", "none", "low", "high" or "max"); "" = model default, "none" = reasoning off
GENERATION_REASONING_EFFORT=none
SUPPORT_CHECK_ENABLED=false
SUPPORT_CHECK_MODEL=
SUPPORT_CHECK_TIMEOUT_S=25.0
# Volontyor javobini AI tekshiruvi (POST /api/v1/assistant/review)
REVIEW_MODEL=
REVIEW_TIMEOUT_S=60.0
REVIEW_MIN_SCORE=3
REVIEW_MIN_CONFIDENCE=0.5
REVIEW_TOP_K=6
REVIEW_RUBRIC_VERSION=1.0
REVIEW_MAX_QUESTION_CHARS=4000
REVIEW_MAX_ANSWER_CHARS=6000

# Storage
STORAGE_DIR=./data/store
CACHE_DB_PATH=./data/cache/query_cache.db

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MOCK_EXTERNAL_APIS=false

# Remote administration (dashboard write actions, API-key management, feedback export).
# Send as X-Admin-Key. Direct localhost access needs no key; leave empty to disable remote admin entirely.
ADMIN_API_KEY=
# Behind nginx/another reverse proxy that does not forward X-Forwarded-For or X-Real-IP, set this to false:
# otherwise every visitor looks like a local connection and needs no key.
ADMIN_LOOPBACK_ENABLED=true

# Editorial: a published curated answer whose linked Lex.uz norm changed is taken offline until reviewed.
EDITORIAL_SUSPEND_ON_CHANGE=true

# huquqplus.uz WordPress plugin (integrations/wordpress). Same value as HUQUQPLUS_RAG_WEBHOOK_SECRET in
# wp-config.php; generate with `openssl rand -hex 32`. Empty disables POST /api/v1/webhooks/huquqplus.
HUQUQPLUS_WEBHOOK_SECRET=

# Huquq+ portal maqolalarini avtomatik sinxronlash davriyligi (daqiqalarda) va holati (true/false)
HUQUQPLUS_SYNC_INTERVAL_MIN=60
HUQUQPLUS_SYNC_ENABLED=true

# Assistant API (src/gateway) jurnallarini saqlash muddati (kunlarda)
ASSISTANT_LOG_RETENTION_DAYS=90
# /health xotira chegarasi (ishlayotgan server uchun, MB)
MEMORY_BUDGET_MB=700

# gateway client key for scripts/eval_3way_sample.py (never hard-code it)
GATEWAY_API_KEY=

# --- Cost control (OpenRouter: embeddings + Jev + ONE light chat model) ---
# Monthly OpenRouter budget in USD. At 80% the light calls move to the generation provider; at 100% embeddings and Jev
# pause (full-text search + RRF order) until the month changes. 0 = no guard. /health shows the state.
OPENROUTER_MONTHLY_BUDGET_USD=15
OPENROUTER_BUDGET_SOFT_RATIO=0.8
# The single chat model on OpenRouter: query rewriting/translation, claim check, backup generation, evaluation judge
UTILITY_MODEL=anthropic/claude-haiku-5.5
GENERATION_MODEL_BACKUP=anthropic/claude-haiku-5.5
# Answers generated per day across all clients (cache hits are free); 0 = no cap
PUBLIC_DAILY_GENERATIONS=3000
# Second key of the generation provider: used automatically after the first answers HTTP 402
PLUS_META_AI_API_KEY=

# --- HTTP hardening ---
# Number of reverse proxies that append to X-Forwarded-For (0 = ignore the header). Not needed with uvicorn --proxy-headers.
TRUSTED_PROXIES=0
MAX_PUBLIC_BODY_BYTES=262144
# Empty = on without ADMIN_API_KEY, off with it (a deployment: the key is the only way in)
# ADMIN_LOOPBACK_ENABLED=true
