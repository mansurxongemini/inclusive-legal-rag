# Copy to .env and fill in. Only what you must or may want to change is listed here; every other setting has a working
# default, with a comment that explains it, in src/config.py.

# --- Required (without a key the service runs offline: placeholder answers, nothing is sent anywhere) ---
# One OpenRouter key serves every call: chat, embeddings, reranking.  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# The one chat model: answers, translation, ranking, review (about $0.04-0.06 per million input tokens)
GENERATION_MODEL_PRIMARY=deepseek/deepseek-v4-flash-0731
# Embedding model of the store's vectors ($0.01 per million tokens). Changing it means re-embedding the whole store
# (scripts/reembed_context.py --all); the service skips vectors made by another model.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_REQUEST_DIMENSIONS=1024

# --- Production ---
# Password of the administration (dashboard, API keys, feedback export), sent as X-Admin-Key.  openssl rand -hex 32
ADMIN_API_KEY=
# Reverse proxies in front of the service that append X-Forwarded-For (0 = none). Use 1 behind one nginx or in Docker,
# otherwise every visitor shares the proxy's address and one rate-limit budget.
TRUSTED_PROXIES=0
# Stop spending at this many USD a month (about $0.0009 per new question): new questions then get "temporarily unavailable"
OPENROUTER_MONTHLY_BUDGET_USD=15
# huquqplus.uz WordPress plugin (integrations/wordpress): the value of HUQUQPLUS_RAG_WEBHOOK_SECRET in wp-config.php.
# Empty disables POST /api/v1/webhooks/huquqplus.
HUQUQPLUS_WEBHOOK_SECRET=
